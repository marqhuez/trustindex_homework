{% extends 'base.html.twig' %}

{% block title %}Companies · Trustindex Homework{% endblock %}

{% block body %}
<main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs tracking-widest text-emerald uppercase">Companies</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Ranked by rating.
    </h1>
    <p class="mt-3 max-w-lg text-ink-soft">
        Every company reviewed, best-rated first.
    </p>

    <div data-controller="company-search" data-company-search-url-value="{{ path('app_company') }}">
        <form method="get" action="{{ path('app_company') }}" class="mt-8 flex gap-3">
            <input type="text"
                   name="q"
                   value="{{ search }}"
                   placeholder="Search by company name…"
                   data-company-search-target="input"
                   data-action="input->company-search#search"
                   class="block w-full rounded-lg border border-paper-deep bg-paper px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/60 focus:border-emerald focus:ring-1 focus:ring-emerald focus:outline-none">
            <button type="submit"
                    class="shrink-0 rounded-full bg-emerald px-6 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-emerald-dark focus:outline-none focus:ring-2 focus:ring-emerald focus:ring-offset-2 focus:ring-offset-white">
                Search
            </button>
        </form>

        <div data-company-search-target="results">
            {{ include('company/_results.html.twig') }}
        </div>
    </div>
</main>
{% endblock %}
