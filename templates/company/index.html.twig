{% extends 'base.html.twig' %}

{% block title %}Companies · Trustindex{% endblock %}

{% block body %}
<main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs tracking-widest text-emerald uppercase">Companies</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Ranked by rating.
    </h1>
    <p class="mt-3 max-w-lg text-ink-soft">
        Every company reviewed, best-rated first.
    </p>

    {% if stats is empty %}
        {% embed '_empty_state.html.twig' %}
            {% block message %}
                No companies yet — <a href="{{ path('app_review_new') }}" class="text-emerald hover:text-emerald-dark">be the first to leave a review</a>.
            {% endblock %}
        {% endembed %}
    {% else %}
        <ul class="mt-10 grid gap-6 sm:grid-cols-2">
            {% for stat in stats %}
                <li class="flex h-40 flex-col justify-between rounded-2xl border border-paper-deep bg-white p-8 shadow-sm shadow-ink/5">
                    <div class="flex items-start justify-between gap-4">
                        <span class="font-medium text-ink">{{ stat.company.name }}</span>
                        <a href="{{ path('app_review_new', { company: stat.company.id }) }}"
                           class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-paper-deep text-ink-soft transition-colors hover:border-emerald hover:text-emerald"
                           aria-label="New review for {{ stat.company.name }}"
                           title="New review">
                            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 5v14M5 12h14"/>
                            </svg>
                        </a>
                    </div>

                    {% if stat.reviewCount > 0 %}
                        <div>
                            <div class="flex items-baseline gap-2">
                                <span class="font-display text-3xl font-semibold text-ink">{{ stat.averageRating|number_format(1) }}</span>
                                {{ include('review/_stars.html.twig', { rating: stat.averageRating, size: 'h-4 w-4' }) }}
                            </div>
                            <p class="mt-2 font-mono text-xs tracking-widest text-ink-soft uppercase">
                                based on {{ stat.reviewCount }} rating{{ stat.reviewCount == 1 ? '' : 's' }}
                            </p>
                        </div>
                    {% else %}
                        <p class="text-sm text-ink-soft">No ratings yet.</p>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</main>
{% endblock %}
