{% extends 'base.html.twig' %}

{% block title %}Reviews · Trustindex{% endblock %}

{% block body %}
<main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs tracking-widest text-emerald uppercase">All reviews</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        What people are saying.
    </h1>
    <p class="mt-3 max-w-lg text-ink-soft">
        Honest words from real customers, newest first.
    </p>

    {% if reviews is empty %}
        <p class="mt-10 rounded-2xl border border-paper-deep bg-white p-8 text-sm text-ink-soft shadow-sm shadow-ink/5">
            No reviews yet — <a href="{{ path('app_review') }}" class="text-emerald hover:text-emerald-dark">be the first to leave one</a>.
        </p>
    {% else %}
        <ul class="mt-10 flex flex-col gap-6">
            {% for review in reviews %}
                {{ include('review/_review_card.html.twig', { review: review }) }}
            {% endfor %}
        </ul>

        {% if totalPages > 1 %}
            <nav class="mt-10 flex items-center justify-between" aria-label="Pagination">
                {% if page > 1 %}
                    <a href="{{ path('app_main_page', { page: page - 1 }) }}"
                       class="rounded-full border border-paper-deep px-5 py-2 text-sm font-medium text-ink transition-colors hover:border-emerald hover:text-emerald">
                        Previous
                    </a>
                {% else %}
                    <span class="rounded-full border border-paper-deep px-5 py-2 text-sm font-medium text-ink-soft/40">Previous</span>
                {% endif %}

                <span class="font-mono text-xs tracking-widest text-ink-soft uppercase">Page {{ page }} of {{ totalPages }}</span>

                {% if page < totalPages %}
                    <a href="{{ path('app_main_page', { page: page + 1 }) }}"
                       class="rounded-full border border-paper-deep px-5 py-2 text-sm font-medium text-ink transition-colors hover:border-emerald hover:text-emerald">
                        Next
                    </a>
                {% else %}
                    <span class="rounded-full border border-paper-deep px-5 py-2 text-sm font-medium text-ink-soft/40">Next</span>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
</main>
{% endblock %}
