{% extends 'base.html.twig' %}

{% block title %}Something went wrong · Trustindex Homework{% endblock %}

{% block body %}
<main class="mx-auto max-w-3xl px-6 py-16 text-center">
    <p class="font-mono text-xs tracking-widest text-rust uppercase">500</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Something went wrong.
    </h1>
    <p class="mt-3 text-ink-soft">
        That's on us, not you — please try again in a moment.
    </p>

    <a href="{{ path('app_review_index') }}"
       class="mt-8 inline-block rounded-full bg-emerald px-6 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-emerald-dark focus:outline-none focus:ring-2 focus:ring-emerald focus:ring-offset-2 focus:ring-offset-white">
        Back to reviews
    </a>
</main>
{% endblock %}
