<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="h-screen overflow-hidden bg-paper font-body text-ink antialiased">
        <div class="pointer-events-none fixed top-4 right-4 z-50 flex flex-col items-end gap-2">
            {% for label, messages in app.flashes() %}
                {% for message in messages %}
                    <div data-controller="toast"
                         class="pointer-events-auto flex items-start gap-3 rounded-xl border px-4 py-3 shadow-lg shadow-ink/5 transition-all duration-300
                                {{ label == 'success' ? 'bg-emerald text-paper border-emerald-dark' : 'bg-rust text-paper border-rust' }}">
                        <span class="mt-0.5 font-mono text-[10px] tracking-widest uppercase opacity-70">
                            {{ label == 'success' ? 'Done' : 'Error' }}
                        </span>
                        <span class="text-sm font-medium">{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div id="page" class="flex h-full flex-col overflow-hidden">
            <header class="z-40 flex-none border-b border-paper-deep bg-white/90 backdrop-blur">
                <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
                    <a href="{{ path('app_review_index') }}"
                       class="flex items-center gap-2 font-mono text-xs tracking-widest text-ink-soft uppercase transition-colors hover:text-emerald">
                        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 11l9-7 9 7"/>
                            <path d="M5 10v9a1 1 0 0 0 1 1h3v-6h6v6h3a1 1 0 0 0 1-1v-9"/>
                        </svg>
                        Home
                    </a>

                    <nav class="flex items-center gap-6 font-mono text-xs tracking-widest uppercase">
                        <a href="{{ path('app_company') }}" class="text-ink-soft transition-colors hover:text-emerald">
                            Companies
                        </a>

                        <a href="{{ path('app_review_new') }}"
                           class="rounded-full bg-emerald px-6 py-2.5 text-sm font-medium text-paper normal-case tracking-normal transition-colors hover:bg-emerald-dark focus:outline-none focus:ring-2 focus:ring-emerald focus:ring-offset-2 focus:ring-offset-white">
                            Send new review
                        </a>
                    </nav>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto [scrollbar-gutter:stable]">
                {% block body %}{% endblock %}
            </div>
        </div>
    </body>
</html>
