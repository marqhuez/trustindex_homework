{% extends 'base.html.twig' %}

{% block title %}Reviews · Trustindex{% endblock %}

{% block body %}
<main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs tracking-widest text-emerald uppercase">All reviews</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        What people are saying.
    </h1>
    <p class="mt-3 max-w-lg text-ink-soft">
        Honest words from real customers, newest first.
    </p>

    {% if reviews is empty %}
        {% embed '_empty_state.html.twig' %}
            {% block message %}
                No reviews yet — <a href="{{ path('app_review_new') }}" class="text-emerald hover:text-emerald-dark">be the first to leave one</a>.
            {% endblock %}
        {% endembed %}
    {% else %}
        <ul class="mt-10 flex flex-col gap-6">
            {% for review in reviews %}
                {{ include('review/_review_card.html.twig', { review: review, page: page }) }}
            {% endfor %}
        </ul>

        {% if totalPages > 1 %}
            <nav class="mt-10 flex items-center justify-center gap-1.5" aria-label="Pagination">
                {% if page > 1 %}
                    <a href="{{ path('app_review_index', { page: page - 1 }) }}"
                       class="flex h-9 w-9 items-center justify-center rounded-full border border-paper-deep text-ink transition-colors hover:border-emerald hover:text-emerald"
                       aria-label="Previous page">‹</a>
                {% else %}
                    <span class="flex h-9 w-9 items-center justify-center rounded-full border border-paper-deep text-ink-soft/40">‹</span>
                {% endif %}

                {% for p in 1..totalPages %}
                    {% if p == 1 or p == totalPages or (p >= page - 2 and p <= page + 2) %}
                        {% if p == page %}
                            <span aria-current="page"
                                  class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald text-sm font-medium text-paper">
                                {{ p }}
                            </span>
                        {% else %}
                            <a href="{{ path('app_review_index', { page: p }) }}"
                               class="flex h-9 w-9 items-center justify-center rounded-full border border-paper-deep text-sm font-medium text-ink transition-colors hover:border-emerald hover:text-emerald">
                                {{ p }}
                            </a>
                        {% endif %}
                    {% elseif p == page - 3 or p == page + 3 %}
                        <span class="flex h-9 w-9 items-center justify-center text-sm text-ink-soft/40">…</span>
                    {% endif %}
                {% endfor %}

                {% if page < totalPages %}
                    <a href="{{ path('app_review_index', { page: page + 1 }) }}"
                       class="flex h-9 w-9 items-center justify-center rounded-full border border-paper-deep text-ink transition-colors hover:border-emerald hover:text-emerald"
                       aria-label="Next page">›</a>
                {% else %}
                    <span class="flex h-9 w-9 items-center justify-center rounded-full border border-paper-deep text-ink-soft/40">›</span>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
</main>
{% endblock %}
