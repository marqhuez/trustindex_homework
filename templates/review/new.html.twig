{% extends 'base.html.twig' %}

{% block title %}Share a review · Trustindex Homework{% endblock %}

{% block body %}
<main class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs tracking-widest text-emerald uppercase">New review</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Tell us how it went.
    </h1>
    <p class="mt-3 max-w-lg text-ink-soft">
        Two minutes, honest words. Your review helps other people choose with confidence.
    </p>

    {{ form_start(form, { attr: { class: 'mt-10 rounded-2xl border border-paper-deep bg-white p-8 shadow-sm shadow-ink/5' } }) }}

        <div class="border-b border-paper-deep pb-8">
            <span class="font-mono text-xs tracking-widest text-ink-soft uppercase">Rating</span>

            <div data-controller="rating"
                 data-rating-labels-value="[&quot;disappointing&quot;,&quot;not great&quot;,&quot;fine&quot;,&quot;good&quot;,&quot;excellent&quot;]"
                 class="mt-3 flex items-center gap-4">
                <div class="flex items-center" role="radiogroup" aria-label="Rating">
                    {% for child in form.rating %}
                        <label data-rating-target="star"
                               data-rating-value="{{ child.vars.value }}"
                               data-action="mouseenter->rating#preview mouseleave->rating#reset click->rating#select"
                               class="cursor-pointer rounded-md p-1 focus-within:ring-2 focus-within:ring-emerald focus-within:ring-offset-2 focus-within:ring-offset-white">
                            {{ form_widget(child, { attr: { class: 'sr-only' } }) }}
                            <svg viewBox="0 0 24 24" class="h-8 w-8 text-ink/15 transition-colors" fill="currentColor" aria-hidden="true">
                                <path d="M12 2.5l2.9 6.6 7.1.7-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.8l7.1-.7z"/>
                            </svg>
                        </label>
                    {% endfor %}
                </div>
                <span data-rating-target="label" class="font-mono text-xs text-ink-soft">Tap a star to rate</span>
            </div>

            {{ form_errors(form.rating) }}
        </div>

        <div class="grid gap-6 pt-8 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label for="{{ form.reviewText.vars.id }}" class="font-mono text-xs tracking-widest text-ink-soft uppercase">
                    Your review
                </label>
                {{ form_widget(form.reviewText, {
                    attr: {
                        class: 'mt-2 block w-full rounded-lg border border-paper-deep bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink-soft/60 focus:border-emerald focus:ring-1 focus:ring-emerald focus:outline-none',
                        rows: 5,
                        placeholder: 'What stood out about your experience?'
                    }
                }) }}
                {{ form_errors(form.reviewText) }}
            </div>

            <div>
                <label for="{{ form.authorEmail.vars.id }}" class="font-mono text-xs tracking-widest text-ink-soft uppercase">
                    Email
                </label>
                {{ form_widget(form.authorEmail, {
                    attr: {
                        class: 'mt-2 block w-full rounded-lg border border-paper-deep bg-paper px-4 py-2.5 text-sm text-ink placeholder:text-ink-soft/60 focus:border-emerald focus:ring-1 focus:ring-emerald focus:outline-none',
                        placeholder: 'you@example.com'
                    }
                }) }}
                {{ form_errors(form.authorEmail) }}
            </div>

            <div data-controller="company-autocomplete"
                 data-company-autocomplete-url-value="{{ path('app_company_search') }}"
                 class="relative">
                <label for="{{ form.companyName.vars.id }}" class="font-mono text-xs tracking-widest text-ink-soft uppercase">
                    Company
                </label>
                <div class="relative mt-2">
                    {{ form_widget(form.companyName, {
                        attr: {
                            class: 'block w-full rounded-lg border border-paper-deep bg-paper px-4 py-2.5 pr-10 text-sm text-ink placeholder:text-ink-soft/60 focus:border-emerald focus:ring-1 focus:ring-emerald focus:outline-none',
                            placeholder: 'Start typing a company name…',
                            autocomplete: 'off',
                            role: 'combobox',
                            'aria-expanded': 'false',
                            'aria-autocomplete': 'list',
                            'data-company-autocomplete-target': 'input',
                            'data-action': 'input->company-autocomplete#search keydown->company-autocomplete#keydown'
                        }
                    }) }}
                    <svg viewBox="0 0 24 24" class="pointer-events-none absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 text-ink-soft" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/>
                        <path d="M21 21l-4.35-4.35"/>
                    </svg>
                </div>
                <ul data-company-autocomplete-target="results"
                    role="listbox"
                    class="absolute z-10 mt-1 hidden max-h-48 w-full overflow-auto rounded-lg border border-paper-deep bg-white py-1 shadow-sm shadow-ink/5">
                </ul>
                <p class="mt-2 text-xs text-ink-soft/70">
                    Pick a match from the list, or keep typing to add a new company.
                </p>
                {{ form_errors(form.companyName) }}
            </div>
        </div>

        <div class="mt-8 flex justify-end">
            {{ form_widget(form.submit, {
                label: 'Send review',
                attr: {
                    class: 'rounded-full bg-emerald px-6 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-emerald-dark focus:outline-none focus:ring-2 focus:ring-emerald focus:ring-offset-2 focus:ring-offset-white'
                }
            }) }}
        </div>

    {{ form_end(form) }}
</main>
{% endblock %}
